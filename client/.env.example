# ─── API Configuration ────────────────────────────────────────────────────────
# Backend API base URL (must end with /).
# Leave empty to use the default local dev server: http://localhost:8000/
# In production, set this in your hosting provider's environment settings
# (e.g. Vercel: VITE_API_URL=https://api.rougevault.com/)
VITE_API_URL=http://localhost:8000/

# ⚠️  IMPORTANT: Never put private credentials (JWT secrets, Razorpay secret key,
#    database passwords) in VITE_ variables — they are bundled into client JS
#    and visible to anyone who visits your site.
