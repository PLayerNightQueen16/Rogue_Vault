# ─── Database ────────────────────────────────────────────────────────────────
dbUrl=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# ─── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret

# ─── Razorpay ─────────────────────────────────────────────────────────────────
razorpay_id=rzp_test_your_test_key_id
razorpay_secret=your_test_key_secret

# ─── Runtime ──────────────────────────────────────────────────────────────────
# PORT defaults to 8000 if not set
PORT=8000

# Set to "production" on deployment host
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of ADDITIONAL allowed frontend origins (production URLs).
# Localhost dev origins are always allowed in development mode.
# Example: ALLOWED_ORIGINS=https://rouge-vault.vercel.app,https://www.rouge-vault.com
ALLOWED_ORIGINS=
